/*--------------------------------*- C++ -*----------------------------------*/
FoamFile { format ascii; class dictionary; object fvSolution; }
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
solvers {
    p_rgh {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-6;
        relTol          0.01;
    }
    "(U|h|k|epsilon)" {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-5;
        relTol          0.1;
    }
}

PIMPLE {
    nNonOrthogonalCorrectors 0;
    pRefCell        0;
    pRefValue       100000;
    residualControl {
        p_rgh           1e-4;
        U               1e-4;
        h               1e-4;
    }
}

relaxationFactors {
    fields { p_rgh 0.7; rho 1.0; }
    equations { U 0.3; h 0.3; }
}