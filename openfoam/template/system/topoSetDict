FoamFile
{
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

actions
(
    // 1. Select the cells in the middle of our domain
    {
        name    heaterSet;
        type    cellSet;
        action  new;
        source  boxToCell;
        sourceInfo
        {
            // Define a 2cm x 2cm block: X(0.04 to 0.06), Y(0 to 0.02), Z(-0.01 to 0.01 to cover the 2D plane)
            box (0.04 0 -0.01) (0.06 0.02 0.01);
        }
    }
    // 2. Convert that selection into an official 'zone' for physics injection
    {
        name    heaterZone;
        type    cellZoneSet;
        action  new;
        source  setToCellZone;
        sourceInfo
        {
            set heaterSet;
        }
    }
);

