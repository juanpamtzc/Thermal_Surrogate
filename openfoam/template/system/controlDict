FoamFile
{
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// For our 2D Conjugate Heat Transfer (steady-state baseline)
application     buoyantFoam;

startFrom       startTime;
startTime       0;

stopAt          endTime;
endTime         1000;      // Run for 1000 steady-state iterations

deltaT          1;         // 1 iteration per step

writeControl    timeStep;
writeInterval   100;       // Output tensor data every 100 iterations

purgeWrite      2;         // Only keep the last 2 outputs to save disk space

writeFormat     ascii;     // Essential: ML parsers read ASCII much easier than binary
writePrecision  6;
writeCompression off;

timeFormat      general;
timePrecision   6;
runTimeModifiable true;

