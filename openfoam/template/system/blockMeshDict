FoamFile
{
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 0.01; // Base unit is centimeters

// Define the boundaries of our 2D channel
vertices
(
    (0 0 0)    // 0
    (10 0 0)   // 1
    (10 4 0)   // 2
    (0 4 0)    // 3
    (0 0 0.1)  // 4
    (10 0 0.1) // 5
    (10 4 0.1) // 6
    (0 4 0.1)  // 7
);

// Define the mesh blocks and resolution
// 100 cells in X, 40 cells in Y, 1 cell in Z (Empty for 2D)
blocks
(
    hex (0 1 2 3 4 5 6 7) (100 40 1) simpleGrading (1 1 1)
);

edges
(
);

// Define boundary conditions
boundary
(
    inlet
    {
        type patch;
        faces
        (
            (0 4 7 3)
        );
    }
    outlet
    {
        type patch;
        faces
        (
            (1 2 6 5)
        );
    }
    bottomWall
    {
        type wall;
        faces
        (
            (0 1 5 4)
        );
    }
    topWall
    {
        type wall;
        faces
        (
            (3 7 6 2)
        );
    }
    frontAndBack
    {
        type empty; // Crucial: Tells OpenFOAM this is a 2D simulation
        faces
        (
            (0 3 2 1)
            (4 5 6 7)
        );
    }
);

mergePatchPairs
(
);

