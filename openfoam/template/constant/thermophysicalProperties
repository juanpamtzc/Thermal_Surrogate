FoamFile
{
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState perfectGas;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        nMoles      1;
        molWeight   28.96;   // Molecular weight of Air
    }
    thermodynamics
    {
        Cp          1004.4;  // Specific heat capacity (J/kg-K)
        Hf          0;
    }
    transport
    {
        mu          1.8e-05; // Dynamic viscosity (kg/m-s)
        Pr          0.7;     // Prandtl number (ratio of momentum to thermal diffusivity)
    }
}
