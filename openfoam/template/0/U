FoamFile
{
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0]; // SI Base Units: meters/second

internalField   uniform (0.1 0 0); // Initialize domain at 0.1 m/s in X-direction

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform (0.1 0 0);
    }
    outlet
    {
        type            zeroGradient; // Flow exits with zero resistance
    }
    bottomWall
    {
        type            noSlip; // Friction applies, velocity becomes 0 at the wall
    }
    topWall
    {
        type            noSlip;
    }
    frontAndBack
    {
        type            empty; // Enforces our 2D constraint
    }
}
